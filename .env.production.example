APP_NAME=TREBBIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trebbia.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=REEMPLAZAR_DB
DB_USERNAME=REEMPLAZAR_USUARIO
DB_PASSWORD=REEMPLAZAR_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.trebbia.app

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=REEMPLAZAR_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REEMPLAZAR_SMTP_USUARIO
MAIL_PASSWORD=REEMPLAZAR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@trebbia.app
MAIL_FROM_NAME=TREBBIA

VITE_APP_NAME=TREBBIA
